<mxfile host="app.diagrams.net"><diagram name="Historias v3 · Adquisición" id="adquisicion"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;Historias v3 · Adquisición&lt;/b&gt;" style="text;html=1;fontSize=34;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="50" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b style=&quot;font-size:22px&quot;&gt;ADQ-1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Lunes 09/11 · noche&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Venta&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Cuando encuentre la campaña que se estabilice, ya está.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Ninguna campaña se estabiliza si cada mes arrancás en cero. Lo estable no es la campaña: es el cliente que vuelve.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Estoy buscando estabilidad en el lugar equivocado.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="360" height="710" as="geometry"/></mxCell><mxCell id="s0h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;cuando encuentre la campaña que se estabilice, ya está.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · de noche, en el auto o afuera&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Es lo que más me dicen en las llamadas. Y tiene lógica, eh: a veces una campaña te anda dos semanas y decís &amp;quot;es esta&amp;quot;. Yo también la busqué un montón. Y a las 48 horas se caía.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «no hay campaña que se estabilice si el 1 del mes arrancás en cero.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n4" value="&lt;b&gt;4. Prueba&lt;/b&gt;&lt;br&gt;Pantalla: «en mis marcas lo estable no es la campaña. son ellos.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n5" value="&lt;b&gt;5. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «el martes 17 a las 18 doy una clase privada y gratis. te muestro cómo lo armé. mandame ADENTRO y te paso el link»&lt;br&gt;&lt;i&gt;Si el anuncio del 08/11 no salió, esta secuencia hace de anuncio.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:22px&quot;&gt;ADQ-2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Miércoles 11/11 · noche&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Caso de éxito&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Un día así es suerte. Le pegó a un anuncio.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Un día así no es suerte: pasa cuando la marca y los números están ordenados.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«No es suerte. Se arma.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="890" width="360" height="710" as="geometry"/></mxCell><mxCell id="s1h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n1" value="&lt;b&gt;1. Hook&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n2" value="&lt;b&gt;2. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «lo primero que pensaste: &amp;quot;suerte. le pegó a un anuncio.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n3" value="&lt;b&gt;3. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · a cámara, en el escritorio&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Es lo que pensaría cualquiera, yo también. Esto es de José: un domingo, 810 pedidos, 45 millones en un día.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n4" value="&lt;b&gt;4. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «la suerte no se repite. esto sí.»&lt;br&gt;&lt;i&gt;Sale solo si cada captura es de un día distinto.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n5" value="&lt;b&gt;5. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «no le pegó a un anuncio. ordenamos la marca y nos metimos en los números.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n6" value="&lt;b&gt;6. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «el martes 17 a las 18 te muestro lo que hago yo en mis marcas. mandame ADENTRO»&lt;br&gt;&lt;i&gt;Antes de que salga: confirmar si José es el socio de Manu. Si lo es, va Lionel o Nico.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:22px&quot;&gt;ADQ-3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Sábado 14/11 · noche&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Venta&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Otro mentor más. Son todos iguales.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;No tenés que creerme. Fijate si te dicen «venís bien» o se meten en tus números.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Por lo menos lo voy a mirar.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="1690" width="360" height="710" as="geometry"/></mxCell><mxCell id="s2h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;otro mentor más. son todos iguales.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · de noche, escritorio con la luz de la pantalla&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Si pensás eso, te entiendo. Muchos de los que trabajan conmigo llegaron así: pagaron una mentoría y todas las semanas les decían venís bien, venís bien… mientras perdían plata.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «no te pido que me creas. fijate si te dicen &amp;quot;venís bien&amp;quot; o se meten en tus números.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n4" value="&lt;b&gt;4. Prueba&lt;/b&gt;&lt;br&gt;Pantalla: «Lionel. 161 millones en el mes.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n5" value="&lt;b&gt;5. Prueba&lt;/b&gt;&lt;br&gt;Pantalla: «Nico. duplicó las ventas.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n6" value="&lt;b&gt;6. Reencuadre&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · la misma toma&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «A ninguno le dije venís bien. Nos metimos en sus números, en la tienda, en todo.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h7" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="2164" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n7" value="&lt;b&gt;7. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «el martes 17 a las 18. clase privada y gratis. venís, mirás y decidís. mandame ADENTRO»&lt;br&gt;&lt;i&gt;No se nombra a ningún mentor ni se dice «estafa».&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="2164" y="2180" width="270" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>