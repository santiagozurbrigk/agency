<mxfile host="app.diagrams.net"><diagram name="Historias v3 · Día de la clase y post-clase" id="clase-y-post"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;Historias v3 · Día de la clase y post-clase&lt;/b&gt;" style="text;html=1;fontSize=34;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="50" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b style=&quot;font-size:22px&quot;&gt;CLASE-1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Martes 17/11 · 9 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Recordatorio&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Un martes a las 18 no llego.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Es una hora y media. Lo que te pasa si no venís, lo seguís teniendo meses.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Me hago el lugar.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="360" height="710" as="geometry"/></mxCell><mxCell id="s0h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;un martes a las 18 no llego.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · recién levantado, en la cocina, con el mate&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Te entiendo, un martes a las 18 estás con mil cosas. Es una hora y media. Y te muestro mis números de este mes, en vivo, sin filtro.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «es una hora y media. lo que te pasa si no venís, lo seguís teniendo meses.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n4" value="&lt;b&gt;4. Loop&lt;/b&gt;&lt;br&gt;Pantalla: «hoy 18 hs. vas a estar?»&lt;br&gt;&lt;i&gt;El resultado vuelve a las 17:30.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n5" value="&lt;b&gt;5. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «si no te anotaste, todavía llegás. mandame ADENTRO»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:22px&quot;&gt;CLASE-2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Martes 17/11 · 12:30&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Interacción&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«La miro después en la repetición.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;En vivo te contesto lo tuyo, y los regalos son para el que está." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="890" width="360" height="710" as="geometry"/></mxCell><mxCell id="s1h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;la miro después en la repetición.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · en el auto o caminando&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Es lo que pensás cuando tenés el día lleno, lo sé. Pero en vivo te contesto lo tuyo, de tu marca. Y los 3 agentes son para el que se queda. Mandame acá abajo qué querés que te responda.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n3" value="&lt;b&gt;3. Loop&lt;/b&gt;&lt;br&gt;Pantalla: «qué querés que te responda hoy en la clase?»&lt;br&gt;&lt;i&gt;Manu contesta 2 o 3 en vivo; el resto vuelve el miércoles.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:22px&quot;&gt;CLASE-3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Martes 17/11 · 15 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Detrás de escena&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Seguro es lo mismo de siempre: producto ganador y creativos.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Hoy no hablo de creativos: hablo de lo que pasa después de que te compran." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="1690" width="360" height="710" as="geometry"/></mxCell><mxCell id="s2h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;seguro es lo mismo de siempre.&amp;quot;»&lt;br&gt;&lt;i&gt;[CARGAR: video del escritorio armado, primera slide tapada]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n2" value="&lt;b&gt;2. Reencuadre&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · el mismo escritorio, 10 segundos&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Hoy no te voy a hablar de creativos ni de producto ganador. Te hablo de lo que pasa después de que te compran.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n3" value="&lt;b&gt;3. Regalo&lt;/b&gt;&lt;br&gt;Pantalla: «hoy te regalo 3 de mis +30 sistemas. andá pensando cuáles.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:22px&quot;&gt;CLASE-4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Martes 17/11 · 17 a 17:55 · la escalera&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Recordatorio&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Ahora no puedo, tengo que mirar las campañas.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Las campañas van a seguir ahí a las 19:30." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="2490" width="360" height="710" as="geometry"/></mxCell><mxCell id="s3h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="2490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s3n1" value="&lt;b&gt;1. 17:00&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · ya en el escritorio + contador&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Falta una hora. Si estás mirando las campañas: van a seguir ahí a las siete y media. Cerrá lo pendiente.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="2980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s3h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="2490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s3n2" value="&lt;b&gt;2. 17:30&lt;/b&gt;&lt;br&gt;Pantalla: «a la mañana te pregunté. mirá.»&lt;br&gt;&lt;i&gt;[CARGAR: resultado real de la encuesta]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="2980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s3h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="2490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s3n3" value="&lt;b&gt;3. 17:50&lt;/b&gt;&lt;br&gt;Pantalla: «en 10 arrancamos.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="2980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s3h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="2490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s3n4" value="&lt;b&gt;4. 17:55&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · sentado para la clase, 5 segundos&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Entrá que arrancamos.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="2980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:22px&quot;&gt;CLASE-5&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Martes 17/11 · durante la clase&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;En vivo · lo sube [NOMBRE] del equipo&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;—&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;—" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="3290" width="360" height="710" as="geometry"/></mxCell><mxCell id="s4h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="3290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s4n1" value="&lt;b&gt;1. Apenas arranca&lt;/b&gt;&lt;br&gt;Pantalla: «soy [NOMBRE], del equipo, le robé el celu a Manu. estamos en vivo. somos [N].»&lt;br&gt;&lt;i&gt;[CARGAR: captura de la sala, sin nombres]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="3780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s4h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="3290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s4n2" value="&lt;b&gt;2. Números&lt;/b&gt;&lt;br&gt;Pantalla: «está mostrando sus números de este mes. todavía llegás.»&lt;br&gt;&lt;i&gt;[CARGAR: foto de la pantalla, producto tapado]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="3780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s4h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="3290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s4n3" value="&lt;b&gt;3. Regalos&lt;/b&gt;&lt;br&gt;Pantalla: «los 3 agentes son para los que se quedan hasta el final.»&lt;br&gt;&lt;i&gt;[CARGAR: foto de la slide de los regalos]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="3780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b style=&quot;font-size:22px&quot;&gt;CLASE-6&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Martes 17/11 · al terminar&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Cierre del día · sin CTA&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;—&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;—" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="4090" width="360" height="710" as="geometry"/></mxCell><mxCell id="s5h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="4090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s5n1" value="&lt;b&gt;1. Cierre&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · cansado, como esté&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Terminé recién. Estoy muerto, pero muy contento. Gracias por quedarte. Lo de los agentes te llega por WhatsApp.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="4580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s5h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="4090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s5n2" value="&lt;b&gt;2. Prueba&lt;/b&gt;&lt;br&gt;Pantalla: «esto me escribieron mientras daba la clase.»&lt;br&gt;&lt;i&gt;[CARGAR: collage del chat de la clase, nombres tapados]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="4580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b style=&quot;font-size:22px&quot;&gt;POST-1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Miércoles 18/11 · 10 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Venta&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Ya entendí la idea. Lo hago solo.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;La idea ya la tenés. Lo que lleva tiempo es aplicarla en tu marca sin romper lo que ya vende.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Solo me va a llevar el doble.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="4890" width="360" height="710" as="geometry"/></mxCell><mxCell id="s6h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;ya entendí la idea. lo hago solo.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · otro lugar, otra remera&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Es lo más lógico de pensar. Yo lo armé solo, eh. Y lo que más me costó no fue entender la idea: fue [lo que le costó de verdad].»&lt;br&gt;&lt;i&gt;Tiene que ser verdad.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «la idea ya la tenés. lo que lleva tiempo es aplicarla en tu marca sin romper lo que ya vende.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n4" value="&lt;b&gt;4. Loop&lt;/b&gt;&lt;br&gt;Pantalla: «me la hicieron [N] veces.»&lt;br&gt;&lt;i&gt;[CARGAR: la pregunta más repetida, tapada, con la respuesta corta]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n5" value="&lt;b&gt;5. Repetición&lt;/b&gt;&lt;br&gt;Pantalla: «si no llegaste, la clase entera está acá. queda arriba hasta el [FECHA REAL].»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n6" value="&lt;b&gt;6. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «génesis está abierto. son 10 lugares y cierra el sábado 21. aplicás en la misma página.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b style=&quot;font-size:22px&quot;&gt;Suelta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Miércoles 18/11 · 21 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Loop&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;—&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Caja: «qué te frena para aplicar?»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="5690" width="360" height="710" as="geometry"/></mxCell><mxCell id="s7h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="5690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s7n1" value="&lt;b&gt;1. Crudo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · de noche, 10 segundos&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Te pregunto en serio: qué te frena? Mandámelo y mañana te contesto, sin vueltas.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="6180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s7h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="5690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s7n2" value="&lt;b&gt;2. Loop&lt;/b&gt;&lt;br&gt;Pantalla: «qué te frena para aplicar?»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="6180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b style=&quot;font-size:22px&quot;&gt;POST-2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Jueves 19/11 · 13 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Venta · objeciones&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;Las que lleguen a la caja (2 o 3)&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Una por una, a cámara&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Lo que me frenaba tenía respuesta.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="6490" width="360" height="710" as="geometry"/></mxCell><mxCell id="s8h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n1" value="&lt;b&gt;1. Duda 1&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;si toco el modelo, rompo lo que hoy vende.&amp;quot;»&lt;br&gt;&lt;i&gt;[CARGAR: la pregunta real, tapada]. Solo si alguien la mandó.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n2" value="&lt;b&gt;2. Reencuadre 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · donde esté&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Tiene sentido tenerle miedo. Pero no tocás nada de lo que hoy te vende: esto va al lado.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n3" value="&lt;b&gt;3. Duda 2&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;en argentina no se suscribe nadie.&amp;quot;»&lt;br&gt;&lt;i&gt;[CARGAR: la pregunta real, tapada]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n4" value="&lt;b&gt;4. Reencuadre 2&lt;/b&gt;&lt;br&gt;Pantalla: «yo también lo pensaba. tengo 3.943 activos. en argentina. se me va el 7,2%.»&lt;br&gt;&lt;i&gt;Manu lo dice a cámara; la captura del panel va encima.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n5" value="&lt;b&gt;5. Duda 3&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;mi producto no es para suscripción.&amp;quot;»&lt;br&gt;&lt;i&gt;[CARGAR: la pregunta real, tapada]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n6" value="&lt;b&gt;6. Reencuadre 3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · donde esté&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Si a tu cliente se le termina, te puede volver a comprar. Y si le resuelve algo, no se queda un mes: se queda un año.»&lt;br&gt;&lt;i&gt;Con el nombre de Alan solo si autoriza.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8h7" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="2164" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n7" value="&lt;b&gt;7. Cierre&lt;/b&gt;&lt;br&gt;Pantalla: «si tenés otra, escribime. y si ya lo tenés claro, aplicá. cierra el sábado 21.»&lt;br&gt;&lt;i&gt;Otras listas en el doc: «ya pagué una mentoría», «primero tengo que facturar más».&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="2164" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b style=&quot;font-size:22px&quot;&gt;Suelta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Jueves 19/11 · noche&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Solo si es real&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;—&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;«Ya están adentro»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="7290" width="360" height="710" as="geometry"/></mxCell><mxCell id="s9h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="7290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s9n1" value="&lt;b&gt;1. Entraron&lt;/b&gt;&lt;br&gt;Pantalla: «ya están adentro. arrancamos.»&lt;br&gt;&lt;i&gt;[CARGAR: capturas reales de los que entraron, tapadas]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="7780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b style=&quot;font-size:22px&quot;&gt;POST-3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Viernes 20/11 · 13 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Producto por dentro&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Me van a dar videos y me van a dejar solo.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;No es un curso para mirar: lo aplicás vos en tu marca, conmigo al lado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«No me van a dejar solo.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="8090" width="360" height="710" as="geometry"/></mxCell><mxCell id="s10h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="8090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s10n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;me van a dar videos y me van a dejar solo.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="8580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s10h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="8090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s10n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · en el escritorio&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Es lo que pasa casi siempre: te dan un acceso, mil videos, y arreglate.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="8580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s10h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="8090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s10n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «esto es génesis por dentro.»&lt;br&gt;&lt;i&gt;[CARGAR: grabación del campus: automatizaciones, flujos, agentes, CRM]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="8580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s10h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="8090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s10n4" value="&lt;b&gt;4. Reencuadre&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · la misma toma&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Hablás conmigo y con José uno a uno, hay cuatro llamadas grupales por semana y me escribís por chat cuando te trabás. Lo aplicás vos en tu marca, conmigo al lado.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="8580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s10h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="8090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s10n5" value="&lt;b&gt;5. Por qué son pocos&lt;/b&gt;&lt;br&gt;Pantalla: «son 10 lugares porque lo trabajo con cada marca. quedan [N].»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="8580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s10h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="8090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s10n6" value="&lt;b&gt;6. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «cierra el sábado 21 a las [HORA]. aplicá acá»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="8580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b style=&quot;font-size:22px&quot;&gt;POST-4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Sábado 21/11 · 12 hs, 21 hs y cierre&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Cierre real&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Si no entro ahora, entro la próxima.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Hoy se cierra esto. Lo que no se cierra es el problema." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="8890" width="360" height="710" as="geometry"/></mxCell><mxCell id="s11h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="8890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s11n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;si no entro ahora, entro la próxima.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="9380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s11h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="8890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s11n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · de día, otro lugar&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Es lo más fácil de pensar, eh. Hoy a la noche cierro Génesis, y cierra de verdad: es uno a uno, no puedo agarrar más marcas. Y mientras tanto, el 1 del mes vas a seguir arrancando en cero.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="9380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s11h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="8890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s11n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «hoy se cierra esto. lo que no se cierra es el problema.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="9380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s11h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="8890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s11n4" value="&lt;b&gt;4. Remate&lt;/b&gt;&lt;br&gt;Pantalla: «la landing te la copian en dos días. tu base de clientes, no.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="9380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s11h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="8890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s11n5" value="&lt;b&gt;5. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «quedan [N] lugares. cierra hoy a las [HORA].»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="9380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s11h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="8890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s11n6" value="&lt;b&gt;6. 21 hs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · de noche, 10 segundos&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Quedan [N] horas. Si lo venías pensando, es ahora.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="9380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s11h7" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="2164" y="8890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s11n7" value="&lt;b&gt;7. 21 hs · CTA&lt;/b&gt;&lt;br&gt;Pantalla: «aplicá acá. hoy a las [HORA] se cierra.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="2164" y="9380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s11h8" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="2458" y="8890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s11n8" value="&lt;b&gt;8. Después del cierre&lt;/b&gt;&lt;br&gt;Pantalla: «se cerró. a los que entraron, nos vemos adentro. y a todos, gracias por estas semanas.»&lt;br&gt;&lt;i&gt;Sin link. El cierre no se extiende.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="2458" y="9380" width="270" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>