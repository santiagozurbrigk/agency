<mxfile host="app.diagrams.net"><diagram name="Historias v3 · Nutrición" id="nutricion"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;Historias v3 · Nutrición&lt;/b&gt;" style="text;html=1;fontSize=34;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="50" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b style=&quot;font-size:22px&quot;&gt;NUT-1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Miércoles 11/11 · 13 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Valor con CTA suave · arranca el grupo&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Si bajo el CPA, se arregla.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;El problema no era cuánto me costaba cada venta: era que cada cliente me compraba una vez.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Capaz el CPA no es mi problema.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="360" height="710" as="geometry"/></mxCell><mxCell id="s0h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;si bajo el CPA, se arregla.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · a la mañana, en la cocina, con el mate&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Tiene lógica, eh. Es lo que te enseña todo el mundo. Yo hacía eso: renovaba creativos, testeaba ángulos, lo bajaba… y al mes siguiente estaba igual.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «el problema no era cuánto me costaba cada venta. era que cada cliente me compraba una vez.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n4" value="&lt;b&gt;4. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «ahí cambió todo en mis marcas.»&lt;br&gt;&lt;i&gt;[CARGAR: grabación del iPad]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n5" value="&lt;b&gt;5. Loop&lt;/b&gt;&lt;br&gt;Pantalla: «de los que te compraron el mes pasado, cuántos te volvieron a comprar?»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s0h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="90" width="270" height="480" as="geometry"/></mxCell><mxCell id="s0n6" value="&lt;b&gt;6. Cierre&lt;/b&gt;&lt;br&gt;Pantalla: «hoy en el grupo dejé el roadmap que seguí. si te anotaste, ya lo tenés. si no, mandame ADENTRO»&lt;br&gt;&lt;i&gt;[CARGAR: captura del roadmap en el grupo, sin números]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:22px&quot;&gt;Suelta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Jueves 12/11 · mañana&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Loop&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;—&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;El resultado de la encuesta del 11" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="890" width="360" height="710" as="geometry"/></mxCell><mxCell id="s1h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n1" value="&lt;b&gt;1. Resultado&lt;/b&gt;&lt;br&gt;Pantalla: «ayer te pregunté cuántos te volvieron a comprar. mirá.»&lt;br&gt;&lt;i&gt;[CARGAR: resultado real de la encuesta]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s1h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s1n2" value="&lt;b&gt;2. Crudo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · donde esté, 10 segundos&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «La mayoría puso &amp;quot;ni idea&amp;quot;. Es normal, yo tampoco lo sabía. Y ese número era todo.»&lt;br&gt;&lt;i&gt;Se ajusta a lo que dio.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="1380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:22px&quot;&gt;NUT-2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Jueves 12/11 · 17 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Caso de éxito · caso de Lucas en el grupo&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Me copiaron: tengo que sacar creativos nuevos.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;La copia no los estaba matando: con 2,4% de margen, cualquier cosa los mataba.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Capaz no me mata la competencia: me matan mis números.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="1690" width="360" height="710" as="geometry"/></mxCell><mxCell id="s2h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;me copiaron. tengo que sacar creativos nuevos.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · a cámara, en el balcón&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Es lo que haría cualquiera. Lucas y Santi, una marca que trabaja conmigo, pensaban eso. Salen otras marcas a vender casi lo mismo, les sube el CPA y una noche estaban 600 lucas abajo. Apagaron todo.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n3" value="&lt;b&gt;3. Prueba (antes)&lt;/b&gt;&lt;br&gt;Pantalla: «1,3M por día. 2,4% de margen.»&lt;br&gt;&lt;i&gt;[CARGAR: imagen 1 del doc del grupo, tapada]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n4" value="&lt;b&gt;4. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «la copia no los estaba matando. con 2,4% de margen, cualquier cosa los mataba.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n5" value="&lt;b&gt;5. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «no sacamos más creativos. nos metimos en la marca y ordenamos los números.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n6" value="&lt;b&gt;6. Prueba (después)&lt;/b&gt;&lt;br&gt;Pantalla: «hoy: 2,8M por día. 40% de margen.»&lt;br&gt;&lt;i&gt;[CARGAR: imágenes 2 y 3 del doc del grupo, tapadas]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h7" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="2164" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n7" value="&lt;b&gt;7. Loop&lt;/b&gt;&lt;br&gt;Pantalla: «vos qué hacés cuando te sube el CPA?»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="2164" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s2h8" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="2458" y="1690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s2n8" value="&lt;b&gt;8. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «el martes 17 a las 18 te muestro lo que hago yo en mis marcas. mandame ADENTRO»&lt;br&gt;&lt;i&gt;El simulador del grupo no se nombra acá: quedaría al lado de Lucas.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="2458" y="2180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:22px&quot;&gt;Suelta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Viernes 13/11 · mañana&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Loop&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;—&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Las respuestas a «qué hacés cuando te sube el CPA»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="2490" width="360" height="710" as="geometry"/></mxCell><mxCell id="s3h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="2490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s3n1" value="&lt;b&gt;1. Respuestas&lt;/b&gt;&lt;br&gt;Pantalla: «me mandaron esto.»&lt;br&gt;&lt;i&gt;[CARGAR: 2 o 3 respuestas reales, con nombre y foto tapados]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="2980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s3h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="2490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s3n2" value="&lt;b&gt;2. Crudo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · donde esté, 10 segundos&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Casi todos me pusieron lo mismo: renovar, apagar, bajar presupuesto. Tiene sentido, yo hacía igual. Hoy a las 13 te muestro otra forma de mirarlo.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="2980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:22px&quot;&gt;NUT-3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Viernes 13/11 · 13 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Valor · sin CTA&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Tengo que conseguir clientes más baratos.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;No gana el que paga menos por cliente: gana el que puede pagar más.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Nunca pensé en cuánto puedo pagar.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="3290" width="360" height="710" as="geometry"/></mxCell><mxCell id="s4h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="3290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s4n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;tengo que conseguir clientes más baratos.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="3780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s4h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="3290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s4n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · caminando por la calle&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Suena obvio, no? Pero mirá lo que pasa: lo bajás, sale uno que te copia, te suben los CPM, por ende te sube el CPA. Saliste con 10 dólares y ahora tenés 20. Es una carrera que no se gana.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="3780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s4h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="3290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s4n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «no gana el que paga menos por cliente. gana el que puede pagar más.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="3780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s4h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="3290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s4n4" value="&lt;b&gt;4. La táctica&lt;/b&gt;&lt;br&gt;Pantalla: «hacé esta cuenta con tus números.»&lt;br&gt;&lt;i&gt;[CARGAR: grabación del iPad, legible para pausar]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="3780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s4h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="3290" width="270" height="480" as="geometry"/></mxCell><mxCell id="s4n5" value="&lt;b&gt;5. Cierre&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · la misma caminata&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Si te dio que te compra una vez, ahí está todo. Ese es el número que hay que mover, no el CPA. Mandame cuánto te dio.»&lt;br&gt;&lt;i&gt;Sin link y sin ADENTRO. Las respuestas vuelven el domingo.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="3780" width="270" height="220" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b style=&quot;font-size:22px&quot;&gt;NUT-4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Sábado 14/11 · 13 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Producto por dentro · flujos de retención en el grupo&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Ese cliente ya me compró. Ya está.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Tu próxima venta más barata ya te compró una vez.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Tengo una base entera a la que nunca le escribí.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="4090" width="360" height="710" as="geometry"/></mxCell><mxCell id="s5h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="4090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s5n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;ese cliente ya me compró. ya está.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="4580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s5h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="4090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s5n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · a cámara, con la pantalla detrás&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Yo pensaba igual. Vendía y chau, y toda la plata iba a traer gente nueva. Al que ya me había comprado no le mandaba ni un mail.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="4580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s5h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="4090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s5n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «tu próxima venta más barata ya te compró una vez.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="4580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s5h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="4090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s5n4" value="&lt;b&gt;4. Por dentro&lt;/b&gt;&lt;br&gt;Pantalla: «esto le llega hoy a cada cliente que me compra.»&lt;br&gt;&lt;i&gt;[CARGAR: grabación scrolleando los flujos de mail y WhatsApp, sin que se lean]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="4580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s5h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="4090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s5n5" value="&lt;b&gt;5. Prueba&lt;/b&gt;&lt;br&gt;Pantalla: «en mis marcas se me va el 7,2%. el resto se queda.»&lt;br&gt;&lt;i&gt;[CARGAR: captura de cancelaciones 7,2%, producto tapado]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="4580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s5h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="4090" width="270" height="480" as="geometry"/></mxCell><mxCell id="s5n6" value="&lt;b&gt;6. Cierre&lt;/b&gt;&lt;br&gt;Pantalla: «hoy en el grupo regalé estos flujos, los mismos que uso yo. si te anotaste, están ahí. si no, mandame ADENTRO»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="4580" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b style=&quot;font-size:22px&quot;&gt;NUT-5&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Domingo 15/11 · 12 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Venta · video de la competencia en el grupo&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Hay demasiados vendiendo lo mismo. Ya no hay lugar.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;La competencia no te gana por ser más: te gana si puede pagar más que vos por cada cliente.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Puedo jugar otro juego.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="4890" width="360" height="710" as="geometry"/></mxCell><mxCell id="s6h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «domingo. abriste el ads manager y pensaste: &amp;quot;hay demasiados vendiendo lo mismo.&amp;quot;»&lt;br&gt;&lt;i&gt;[CARGAR: foto real del celular con el Ads Manager en el sillón]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · en casa, domingo, de entrecasa&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Tiene sentido, eh. Cada semana sale uno nuevo con lo mismo que vos. Yo lo pensaba todos los domingos.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n3" value="&lt;b&gt;3. Loop&lt;/b&gt;&lt;br&gt;Pantalla: «me mandaron esto.»&lt;br&gt;&lt;i&gt;[CARGAR: 2 o 3 respuestas reales a «cuánto te dio?». Si no hay, no sale]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n4" value="&lt;b&gt;4. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «la competencia no te gana por ser más. te gana si puede pagar más que vos por cada cliente.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n5" value="&lt;b&gt;5. Reencuadre&lt;/b&gt;&lt;br&gt;&lt;i&gt;Qué cuenta: operando en 75.000 pagás 2,5 veces más y te sigue quedando plata; tu competencia no puede porque se funde.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h6" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1870" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n6" value="&lt;b&gt;6. Remate&lt;/b&gt;&lt;br&gt;Pantalla: «no es que haya mucha competencia. es que todos juegan el mismo juego.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1870" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s6h7" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="2164" y="4890" width="270" height="480" as="geometry"/></mxCell><mxCell id="s6n7" value="&lt;b&gt;7. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «el martes 17 a las 18 te muestro el otro juego. faltan 2 días. mandame ADENTRO»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="2164" y="5380" width="270" height="220" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b style=&quot;font-size:22px&quot;&gt;NUT-6&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Lunes 16/11 · 13 hs&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Recordatorio&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Otra clase gratis para venderme algo.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;No es otro curso de producto ganador: son mis sistemas y mis números, en pantalla.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Mañana no es otra clase más.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="5690" width="360" height="710" as="geometry"/></mxCell><mxCell id="s7h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="5690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s7n1" value="&lt;b&gt;1. Creencia&lt;/b&gt;&lt;br&gt;Pantalla: «&amp;quot;otra clase gratis para venderme algo.&amp;quot;»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="6180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s7h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="5690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s7n2" value="&lt;b&gt;2. Por qué tiene sentido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · en el escritorio, armando la clase&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Te entiendo, hay mil. Y casi todas son de cómo pegar un winner. Mañana no: te muestro mis sistemas y mis números de este mes, en pantalla.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="6180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s7h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="5690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s7n3" value="&lt;b&gt;3. Reencuadre&lt;/b&gt;&lt;br&gt;Pantalla: «spoiler.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="6180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s7h4" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1282" y="5690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s7n4" value="&lt;b&gt;4. Qué tener listo&lt;/b&gt;&lt;br&gt;Pantalla: «para mañana: una hora y media sin interrupciones. compu, no celular. y tus números a mano.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1282" y="6180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s7h5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="1576" y="5690" width="270" height="480" as="geometry"/></mxCell><mxCell id="s7n5" value="&lt;b&gt;5. Contador&lt;/b&gt;&lt;br&gt;Pantalla: «clase privada · mar 17 · 18 hs»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1576" y="6180" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b style=&quot;font-size:22px&quot;&gt;NUT-6 noche&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Lunes 16/11 · noche · último llamado&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Último llamado&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Creencia&lt;/b&gt;&lt;br&gt;«Me anoto mañana.»&lt;br&gt;&lt;br&gt;&lt;b&gt;Reencuadre&lt;/b&gt;&lt;br&gt;Mañana ya no paso el link.&lt;br&gt;&lt;br&gt;&lt;b&gt;Al terminar tiene que pensar&lt;/b&gt;&lt;br&gt;«Mañana no es otra clase más.»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#FF6A13;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="6490" width="360" height="710" as="geometry"/></mxCell><mxCell id="s8h1" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="400" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n1" value="&lt;b&gt;1. Prueba&lt;/b&gt;&lt;br&gt;Pantalla: «esto fue esta semana.»&lt;br&gt;&lt;i&gt;[CARGAR: collage de DMs reales con ADENTRO, nombres tapados]&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8h2" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="694" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n2" value="&lt;b&gt;2. Creencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#B42318&quot;&gt;Video en crudo · de noche, 10 segundos&lt;/span&gt;&lt;br&gt;&lt;b&gt;Algo así:&lt;/b&gt; «Si pensabas anotarte mañana: mañana ya no paso el link. Es ahora.»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="6980" width="270" height="220" as="geometry"/></mxCell><mxCell id="s8h3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="988" y="6490" width="270" height="480" as="geometry"/></mxCell><mxCell id="s8n3" value="&lt;b&gt;3. CTA&lt;/b&gt;&lt;br&gt;Pantalla: «mandame ADENTRO y te paso el link»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="988" y="6980" width="270" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>