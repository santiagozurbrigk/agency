{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/clase", "destination": "/" },
    { "source": "/(1|2|3|a|b)", "destination": "/" },
    { "source": "/(a1|a2|a3|b1|b2|b3|c1|c2|c3)", "destination": "/" },
    { "source": "/(cpa|margen|meta)", "destination": "/" },
    { "source": "/(application|aplicacion|aplicar)", "destination": "/aplication" }
  ],
  "headers": [
    {
      "source": "/(wins|slides|ventas|bonus|replay-assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(manu.jpg|favicon.svg|apple-touch-icon.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
